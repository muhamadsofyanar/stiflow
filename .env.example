# ================================================================
# STIFLOW BRANCH PLATFORM - ENV TEMPLATE PER-CABANG
# Copy file ini menjadi .env lalu ganti nilai sesuai cabang & server
# ================================================================

# --- Konfigurasi Identitas Cabang (PALING PENTING, WAJIB DIISI UNIK SETIAP CABANG) ---
APP_NAME="STIFLOW Cabang GANTI-KODE-CABANG"
# Contoh: JML-CAB-62, BKS-CAB-40, KHU-CAB-01, TNG-CAB-17, DLL
BRANCH_CODE=GANTI-KODE-CABANG-001
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL publik domain cabang (contoh: https://jml62.stiflow.id)
APP_URL=https://ganti-subdomain-cabang.stiflow.id
ASSET_URL="${APP_URL}"
LIVEWIRE_ASSET_URL="${APP_URL}"

# --- Localization Indonesia ---
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ================================================================
# DATABASE (MySQL 8 wajib untuk deployment produksi)
# ================================================================
# Produksi Voucher MVP
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stiflow_ganti_kode_cabang
DB_USERNAME=stiflow
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Queue (default: database, untuk job kirim WA / email / commission scheduler) ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# --- Optional (TIDAK PERLU DIISI KALAU TIDAK PAKAI) ---
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ================================================================
# EMAIL OUTBOUND
# ================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=ganti-smtp.cabang.stiflow.id
MAIL_PORT=587
MAIL_USERNAME=ganti-user@stiflow.id
MAIL_PASSWORD=ganti-password-email
MAIL_FROM_ADDRESS="noreply-ganti-cabang@stiflow.id"
MAIL_FROM_NAME="${APP_NAME}"

# ================================================================
# INTEGRASI PRODUKSI STIFIN PUSAT (API APPRO)
# ================================================================
# Base URL default production APRO STIFIN
STIFIN_API_BASE_URL=https://apro.stifin.id/api
STIFIN_AUTH_HEADER=Authorization
STIFIN_AUTH_VALUE=
STIFIN_USER_ID=STIFLOW-SYSTEM
STIFIN_CONNECT_TIMEOUT=15
STIFIN_TIMEOUT=30

# ================================================================
# PAYMENT GATEWAY (PILIH SALAH SATU SESUAI KONTRAK CABANG)
# ================================================================
# Midtrans
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_IS_PRODUCTION=true
# Finpay / Ipaymu
FINPAY_MERCHANT_ID=
FINPAY_MERCHANT_KEY=
FINPAY_IS_PRODUCTION=true
# Rekening Transfer Manual BCA Cabang
MANUAL_TRANSFER_BANK=BCA
MANUAL_TRANSFER_ACCOUNT=7654321098
MANUAL_TRANSFER_HOLDER="PT STIFLOW Cabang ${BRANCH_CODE}"

# ================================================================
# WHATSAPP PROVIDER (PILIH SALAH SATU)
# ================================================================
# StarSender
STARSENDER_API_ENDPOINT=
STARSENDER_API_KEY=
STARSENDER_DEVICE_ID=
# OneSender
ONESENDER_API_ENDPOINT=
ONESENDER_API_KEY=
ONESENDER_DEVICE_ID=

# ================================================================
# TELEGRAM BOT (NOTIFIKASI ORDER / PEMBAYARAN KE ADMIN CABANG)
# ================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ================================================================
# APP LICENSE (VALIDASI UPDATE PLATFORM DARI PUSAT)
# ================================================================
APP_LICENSE_KEY=
APP_LICENSE_HUB_URL=https://license.stiflow.id/api/validate

# --- Vite ----
VITE_APP_NAME="${APP_NAME}"
